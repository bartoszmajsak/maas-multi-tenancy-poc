# Tenant-A MaaS API configuration
maas-api-image=quay.io/bmajsak/maas-api:gw
instance-name=tenant-a
gateway-sa-audience=tenant-a-sa
gateway-namespace=openshift-ingress
gateway-name=tenant-a-gateway

maas-tier-lookup-url=https://maas-api.tenant-a.svc.cluster.local:8443/v1/tiers/lookup
keycloak-jwks-url=http://tenant-poc-keycloak-service.keycloak-system.svc.cluster.local:8080/realms/tenant-a/protocol/openid-connect/certs
